<?php

declare(strict_types=1);

namespace App\Components;

use App\I18n;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Storage\StorageType;

use function Polidog\UsePhp\Runtime\fc;

/**
 * Search box. `query` pre-fills the field; `large` switches to the
 * results-page size; `locale` keeps the GET form on the locale's own
 * `/search` path so results stay in that language. Plain GET form
 * (works without JS). Square, hairline-ruled, dark-mode aware.
 *
 * Wrapped in fc(..., StorageType::Memory): this component holds no
 * state, but use-php's default StorageType::Session would construct a
 * SessionStorage (which calls session_start()) on every render. That
 * emits `Set-Cookie: PHPSESSID`, which makes Cloudflare BYPASS the
 * cache for every page this appears on (i.e. all of them). Memory
 * storage is session-free, so the read pages stay edge-cacheable
 * (App\PageCache s-maxage). No snapshot secret needed.
 */
return fc(
    function (array $props) {
        $locale = $props['locale'] ?? I18n::DEFAULT;
        $en = 'en' === $locale;
        $large = $props['large'] ?? false;

        return (
        <form
            action={I18n::path($locale, '/search')}
            method="get"
            className="flex border border-rule bg-sheet focus-within:border-draft"
        >
            <input
                type="search"
                name="q"
                value={$props['query'] ?? null}
                placeholder={$en ? 'Search the docs…' : 'ドキュメントを検索…'}
                autocomplete="off"
                className={'flex-1 min-w-0 bg-transparent px-3 text-ink placeholder:text-muted focus:outline-none ' . ($large ? 'py-3 text-base' : 'py-2 text-sm')}
            />
            <button
                type="submit"
                className={'shrink-0 px-3.5 font-mono text-[10px] uppercase tracking-[0.16em] text-muted hover:text-draft border-l border-rule ' . ($large ? 'py-3' : 'py-2')}
            >{$en ? 'Find' : '検索'}</button>
        </form>
        );
    },
    storageType: StorageType::Memory,
);
