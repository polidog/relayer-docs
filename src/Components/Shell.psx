<?php

declare(strict_types=1);

namespace App\Components;

use App\Docs\Nav;
use App\I18n;
use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Storage\StorageType;

use function Polidog\UsePhp\Runtime\fc;

/**
 * The doc shell: sidebar (search + category nav) | content sheet. It
 * also owns the page container — the layout hands pages a bare
 * full-width slot so the landing page can run full-bleed bands, so
 * every Shell-composed page gets its gutter from here.
 *
 * Props: store (DocStore), active (?string slug), locale (string,
 * default 'ja'), children. The language switcher is NOT here — it moved
 * into the header (src/Pages/layout.psx) so the landing page and the
 * index, which compose no Shell, can switch too.
 *
 * Wrapped in fc(..., StorageType::Memory) for the same reason as
 * SearchForm: this shell is stateless, but use-php's default
 * StorageType::Session starts a PHP session on render and emits
 * `Set-Cookie: PHPSESSID`, which forces Cloudflare to BYPASS the
 * edge cache on every page. Memory storage is session-free, keeping
 * the read pages cacheable (App\PageCache s-maxage).
 */
return fc(
    function (array $props) {
    $store = $props['store'];
    $active = $props['active'] ?? null;
    $locale = $props['locale'] ?? I18n::DEFAULT;
    $groups = Nav::groups($store, $locale);

    $linkBase = 'block pl-3 py-1.5 text-sm no-underline border-l ';
    $linkOff = $linkBase . 'border-rule text-muted hover:text-draft hover:border-draft';
    $linkOn = $linkBase . 'border-draft border-l-2 text-draft font-medium bg-draft/[0.07]';

    return (
        <div className="max-w-6xl mx-auto px-4 md:px-6 py-8 md:py-10 grid gap-8 md:gap-10 items-start grid-cols-1 md:grid-cols-[228px_minmax(0,1fr)]">
            <aside id="sidebar" className="hidden md:block md:sticky md:top-20 self-start">
                <SearchForm locale={$locale} />

                <nav className="mt-6">
                    {array_map(fn (array $g) => (
                        <div className="mb-6">
                            <div className="font-mono text-[10px] font-medium tracking-[0.18em] uppercase text-muted mb-2">{I18n::category($locale, $g['category'])}</div>
                            <ul className="list-none m-0 p-0">
                                {array_map(fn ($d) => (
                                    <li>
                                        <a
                                            href={I18n::path($locale, '/docs/' . $d->slug)}
                                            className={$d->slug === $active ? $linkOn : $linkOff}
                                        >{$d->title}</a>
                                    </li>
                                ), $g['docs'])}
                            </ul>
                        </div>
                    ), $groups)}
                </nav>
            </aside>

            <main className="min-w-0 bp-sheet border border-rule bg-sheet px-4 py-8 md:px-10 md:py-10">
                {$props['children'] ?? null}
            </main>
        </div>
    );
    },
    storageType: StorageType::Memory,
);
