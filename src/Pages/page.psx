<?php

declare(strict_types=1);

use App\Components\Caption;
use App\I18n;
use App\Landing;
use App\Meta;
use App\PageCache;
use Polidog\Relayer\Http\Request;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;

// PSX components are resolved at runtime via the compiled component
// manifest, so the batch compiler must not treat them as unresolved.
// @psx-runtime App\Components\Caption

/**
 * Home — the landing page for Relayer itself, drawn as a specification
 * sheet: a title block, then numbered figures (the request path, the
 * route map, one whole page of source) and a spec list that hands off
 * to `/docs`.
 *
 * The documentation index moved to `src/Pages/docs/page.psx`; this page
 * deliberately carries no sidebar and no doc-store data, so it renders
 * without touching the corpus.
 */
return function (PageContext $ctx, Request $req): Closure {
    $locale = I18n::normalize($req->locale());
    $en = 'en' === $locale;
    $c = Landing::content($locale);

    $ctx->metadata(Meta::forPage(
        $en ? 'Relayer — a PHP full-stack framework' : 'Relayer — PHP フルスタックフレームワーク',
        $en
            ? 'Relayer is a convention-first PHP full-stack framework inspired by the Next.js App Router. Routing, APIs, auth, caching and the database in one boot entry — no build step.'
            : 'Relayer は Next.js App Router 風の規約重視な PHP フルスタックフレームワーク。ルーティング・API・認証・キャッシュ・DB をひとつの boot エントリに。ビルドステップなし。',
        '/',
        'home',
        $locale,
    ));

    // FIG.03 is a `<pre><code>` plate, so this route loads highlight.js
    // the same per-page way the doc pages do (App asset convention:
    // external scripts are declared by the page that needs them).
    $ctx->js('https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js', defer: true);

    // Fully static copy (App\Landing) — nothing here reads the doc
    // store, so the ETag only has to move when the page's own text or
    // markup does. PageCache::REVISION covers the markup; the locale
    // covers the copy.
    $ctx->cache(PageCache::timed('landing-' . $locale));

    $band = 'border-b border-rule';
    $wrap = 'max-w-7xl mx-auto px-4 md:px-6';
    $btn = 'inline-flex items-center gap-2 px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.18em] no-underline';
    $btnPrimary = $btn . ' bg-draft text-paper hover:bg-ink';
    $btnGhost = $btn . ' border border-rule text-ink hover:border-draft hover:text-draft';

    return fn () => (
        <div>
            <section className={$band}>
                <div className={$wrap . ' py-14 md:py-20 grid gap-12 lg:gap-16 grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,440px)] items-center'}>
                    <div className="min-w-0">
                        <div className="font-mono text-[11px] uppercase tracking-[0.2em] text-draft">{$c['eyebrow']}</div>
                        <h1 className="mt-5 font-display font-bold leading-[1.06] tracking-[-0.02em] text-[1.7rem] sm:text-5xl md:text-6xl text-ink">
                            <span className="block">{$c['headline'][0]}</span>
                            <span className="block">{$c['headline'][1]}</span>
                        </h1>
                        <p className="mt-6 max-w-xl text-[15px] md:text-base leading-relaxed text-muted">{$c['lead']}</p>
                        <div className="mt-9 flex flex-wrap items-center gap-3">
                            <a href={I18n::path($locale, '/docs/getting-started')} className={$btnPrimary}>{$c['ctaPrimary'] . ' ▸'}</a>
                            <a href={I18n::path($locale, '/docs')} className={$btnGhost}>{$c['ctaSecondary']}</a>
                        </div>
                        <div className="mt-7 inline-flex max-w-full items-baseline gap-2 border border-rule bg-sheet px-3.5 py-2.5 font-mono text-[12.5px] overflow-x-auto">
                            <span className="text-draft select-none">$</span>
                            <span className="text-ink whitespace-nowrap">{$c['install']}</span>
                        </div>

                        <dl className="mt-7 grid gap-px bg-rule border border-rule grid-cols-1 sm:grid-cols-3 max-w-xl">
                            {array_map(fn (array $f) => (
                                <div className="bg-sheet px-3.5 py-2.5">
                                    <dt className="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{$f[0]}</dt>
                                    <dd className="m-0 mt-1 text-sm text-ink">{$f[1]}</dd>
                                </div>
                            ), $c['spec'])}
                        </dl>
                    </div>

                    <div className="min-w-0">
                        <figure className="bp-sheet m-0 border border-rule">
                            <div className="flex items-center justify-between gap-3 border-b border-rule bg-sheet px-4 py-2.5 font-mono text-[10px] text-muted">
                                <span className="uppercase tracking-[0.16em] text-draft">Fig.01</span>
                                <span className="truncate text-[11px]">src/Pages/hello/[name]/page.psx</span>
                            </div>
                            <pre className="m-0 overflow-x-auto bg-plate px-5 py-4 text-[12.5px] leading-[1.7] text-slate-200"><code className="language-php">{$c['sample']}</code></pre>
                            <figcaption className="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-rule bg-sheet px-4 py-2.5 font-mono text-[11.5px]">
                                <span className="text-ink">{$c['sampleRequest']}</span>
                                <span className="bp-leader"></span>
                                <span className="text-draft">{$c['sampleResponse']}</span>
                            </figcaption>
                        </figure>
                        <p className="mt-3 text-[13px] leading-relaxed text-muted">{$c['sampleNote']}</p>
                    </div>
                </div>
            </section>

            <section className={$band}>
                <div className={$wrap . ' py-14 md:py-16'}>
                    <Caption fig="Fig.02" title={$c['figures']['routes']} />
                    <div className="mt-6 bp-sheet border border-rule bg-sheet">
                        {array_map(fn (array $r) => (
                            <div className="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-3.5 border-b border-rule last:border-b-0">
                                <span className="font-mono text-[12.5px] text-ink break-all">{$r[0]}</span>
                                <span className="bp-leader"></span>
                                <span className="font-mono text-[12.5px] text-draft break-all">{$r[1]}</span>
                            </div>
                        ), $c['routes'])}
                    </div>
                    <p className="mt-3.5 font-mono text-[11px] text-muted">{$c['routesNote']}</p>
                </div>
            </section>

            <section className={$band}>
                <div className={$wrap . ' py-14 md:py-16 grid gap-8 lg:gap-12 grid-cols-1 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] items-start'}>
                    <div className="min-w-0">
                        <Caption fig="Fig.03" title={$c['figures']['lifecycle']} />
                        <p className="mt-5 text-[15px] leading-relaxed text-muted">{$c['lifecycleNote']}</p>
                    </div>

                    <div className="min-w-0 bp-sheet border border-rule bg-sheet p-5 md:p-6">
                        <div className="pl-[23px] font-mono text-[12.5px] text-ink break-all">{$c['lifecycle']['input']}</div>

                        <div className="relative mt-3">
                            <div className="absolute left-[4px] -top-4 -bottom-4 w-px bg-draft/50"></div>
                            <div className="absolute left-[1px] top-0 w-[7px] h-[7px] bg-draft bp-signal"></div>
                            <ol className="list-none m-0 p-0">
                                {array_map(fn (array $s) => (
                                    <li className="flex items-start gap-3.5 py-2.5">
                                        <span className="mt-[5px] w-[9px] h-[9px] shrink-0 border border-draft bg-sheet"></span>
                                        <span className="min-w-0">
                                            <span className="block font-mono text-[12.5px] text-ink break-all">{$s[0]}</span>
                                            <span className="block text-[12px] text-muted mt-0.5">{$s[1]}</span>
                                        </span>
                                    </li>
                                ), $c['lifecycle']['steps'])}
                            </ol>
                        </div>

                        <div className="mt-7 pt-4 pl-[23px] border-t border-rule font-mono text-[12.5px] text-draft">{$c['lifecycle']['output']}</div>
                    </div>
                </div>
            </section>

            <section className={$band}>
                <div className={$wrap . ' py-14 md:py-16'}>
                    <Caption fig="Spec" title={$en ? 'What comes in the box' : 'できること'} />
                    <div className="mt-6 border border-rule bg-sheet">
                        {array_map(fn (array $s) => (
                            <a
                                href={I18n::path($locale, '/docs/' . $s['slug'])}
                                className="group grid grid-cols-1 md:grid-cols-[120px_minmax(0,1fr)_auto] gap-x-6 gap-y-1.5 items-baseline px-4 py-5 border-b border-rule last:border-b-0 no-underline hover:bg-draft/[0.05]"
                            >
                                <span className="font-mono text-[10px] uppercase tracking-[0.18em] text-draft">{$s['key']}</span>
                                <span className="min-w-0">
                                    <span className="block font-display text-lg font-semibold text-ink">{$s['title']}</span>
                                    <span className="block mt-1 text-sm leading-relaxed text-muted">{$s['body']}</span>
                                </span>
                                <span className="hidden md:block font-mono text-xs text-muted group-hover:text-draft">▸</span>
                            </a>
                        ), $c['specs'])}
                    </div>
                    <div className="mt-4">
                        <a href={I18n::path($locale, '/docs')} className="font-mono text-[11px] uppercase tracking-[0.18em] text-draft no-underline hover:underline">{$c['specsMore'] . ' ▸'}</a>
                    </div>
                </div>
            </section>

            <section className={$band}>
                <div className={$wrap . ' py-14 md:py-16'}>
                    <Caption fig="Colophon" title={$en ? 'This site' : 'このサイト'} />
                    <div className="mt-6 grid gap-px bg-rule border border-rule md:grid-cols-2">
                        {array_map(fn (array $row) => (
                            <div className="bg-sheet px-4 py-3.5">
                                <div className="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{$row[0]}</div>
                                <div className="mt-1 text-sm text-ink">{$row[1]}</div>
                            </div>
                        ), $c['colophon'])}
                    </div>
                    <p className="mt-3.5 text-sm text-muted">
                        {$c['colophonNote'] . ' '}
                        <a
                            href="https://github.com/polidog/relayer-docs"
                            target="_blank"
                            rel="noopener noreferrer"
                            className="text-draft no-underline hover:underline"
                        >github.com/polidog/relayer-docs</a>
                    </p>
                </div>
            </section>

            <section>
                <div className={$wrap . ' py-16 md:py-20 text-center'}>
                    <p className="font-display text-2xl md:text-4xl font-semibold tracking-[-0.01em] text-ink max-w-3xl mx-auto leading-snug">
                        <span className="block">{$c['closing'][0]}</span>
                        <span className="block">{$c['closing'][1]}</span>
                    </p>
                    <div className="mt-8">
                        <a href={I18n::path($locale, '/docs/getting-started')} className={$btnPrimary}>{$c['closingCta'] . ' ▸'}</a>
                    </div>
                </div>
            </section>
        </div>
    );
};
