<?php

declare(strict_types=1);

use App\Components\Shell;
use App\Docs\DocStore;
use App\Docs\Markdown;
use App\Docs\Nav;
use App\Docs\When;
use App\I18n;
use App\Meta;
use App\PageCache;
use Polidog\Relayer\Http\Cache;
use Polidog\Relayer\Http\Request;
use Polidog\Relayer\Router\Component\PageContext;
use Polidog\UsePhp\Html\H;

// Component resolved at runtime via the compiled component manifest.
// @psx-runtime App\Components\Shell

/**
 * A single documentation page. The slug is the dynamic `[slug]`
 * segment; the Markdown body is rendered into an element tree and
 * styled with @tailwindcss/typography. The class list is just `prose`;
 * the palette comes from the `--tw-prose-*` overrides in
 * App\DocumentFactory. (That stylesheet writes the selector as
 * `.prose.prose` purely to outrank the plugin's own rule — a repeated
 * class matches this single `prose` here.) Plus prev/next navigation
 * and the revision list.
 */
return function (PageContext $ctx, Request $req, DocStore $store): Closure {
    $locale = I18n::normalize($req->locale());
    $en = 'en' === $locale;
    $slug = $ctx->params['slug'] ?? '';
    $doc = '' === $slug ? null : $store->get($slug, $locale);

    if (null === $doc) {
        \http_response_code(404);
        $ctx->cache(new Cache(noStore: true));
        $ctx->metadata(Meta::forPage(
            $en ? 'Page not found — Relayer Docs' : 'ページが見つかりません — Relayer Docs',
            $en ? 'The documentation you requested was not found.' : 'お探しのドキュメントは見つかりませんでした。',
            '/docs/' . $slug,
            'home',
            $locale,
        ));

        return fn () => (
            <Shell store={$store} active={null} locale={$locale}>
                <section className="py-12 md:py-16">
                    <div className="font-mono text-[11px] uppercase tracking-[0.2em] text-mark">404 — not found</div>
                    <h1 className="mt-4 font-display text-4xl md:text-5xl font-bold tracking-[-0.02em] text-ink">{$en ? 'No such sheet' : 'その図面はありません'}</h1>
                    <p className="mt-4 text-muted">
                        {$en ? 'Nothing is filed under ' : '次のスラグに対応するページはありません: '}
                        <span className="font-mono text-ink">{$slug}</span>
                    </p>
                    <div className="mt-8">
                        <a
                            href={I18n::path($locale, '/docs/getting-started')}
                            className="inline-flex items-center gap-2 px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.18em] bg-draft text-paper hover:bg-ink no-underline"
                        >{($en ? 'Start reading' : '最初から読む') . ' ▸'}</a>
                    </div>
                </section>
            </Shell>
        );
    }

    // Requested en but only the canonical ja exists → the store served
    // the ja record (fallback). Surface it instead of silently showing
    // Japanese under an English URL.
    $untranslated = $en && $doc->locale !== $locale;

    $ctx->metadata(Meta::forDoc($doc, $locale));

    // Syntax highlighting: load highlight.js only here (the sole route
    // with `<pre><code>` blocks), not globally. Emitted at end of <body>
    // with defer; the head-side init (index.php) runs it. The 404 branch
    // above intentionally skips this — no code blocks there.
    $ctx->js('https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js', defer: true);

    // Time-based (PageCache::TTL): a cache hit never wakes PHP or the
    // remote Turso DB. The ETag is the page's own content hash, so a
    // post-expiry revalidation is a 304 that skips the (heavy) Markdown
    // render below. Edits via `bin/docs` surface after at most the TTL.
    // Keyed on the *requested* locale: ja stays exactly `doc-<hash>`
    // (byte-identical ETag — canonical pages never revalidate), and a
    // ja-fallback page served under /en still gets its own en key so
    // the CDN can't cross-serve the two language chromes.
    $ctx->cache(PageCache::timed(
        I18n::DEFAULT === $locale ? 'doc-' . $doc->hash : 'doc-' . $locale . '-' . $doc->hash,
    ));

    $md = new Markdown();
    $body = $md->render($doc->content);
    $pn = Nav::prevNext(Nav::flat($store, $locale), $doc->slug);

    // Change history: newest first, in the *served* locale ($doc->locale
    // — a ja-fallback page shows ja history matching its ja body; a real
    // en page shows the en translation's own history). "最終更新" tracks
    // the latest content change (a no-op edit that only bumps updated_at
    // adds no revision), falling back to the row timestamp only before
    // the first revision exists. The oldest revision is the page's
    // creation. Both move only when $doc->hash moves, so the existing
    // doc[-locale]-<hash> ETag still flips exactly when this block changes.
    $revisions = $store->revisions($doc->slug, 50, $doc->locale);
    $lastChanged = $store->lastChangedAt($doc->slug, $doc->locale) ?? $doc->updatedAt;
    $oldestRevId = [] === $revisions ? 0 : $revisions[\array_key_last($revisions)]->id;

    return fn () => (
        <Shell store={$store} active={$doc->slug} locale={$locale}>
            <article>
                <div className="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-[10px] uppercase tracking-[0.18em] text-muted mb-6">
                    <a href={I18n::path($locale, '/docs/getting-started')} className="text-draft no-underline hover:underline">Docs</a>
                    <span>{'' !== $doc->category ? I18n::category($locale, $doc->category) : ($en ? 'Documentation' : 'ドキュメント')}</span>
                    <span className="bp-leader"></span>
                    <span className="normal-case tracking-normal">{$doc->slug}</span>
                </div>

                {$untranslated ? (
                    <div className="mb-6 px-4 py-3 text-sm border border-mark/40 bg-mark/[0.07] text-ink">
                        This page hasn’t been translated yet — showing the original Japanese.
                    </div>
                ) : null}

                <div className="prose max-w-none">
                    {$body}
                </div>

                {(null !== $pn['prev'] || null !== $pn['next']) ? (
                    <div className="flex flex-col sm:flex-row gap-px mt-12 bg-rule border border-rule">
                        {null !== $pn['prev'] ? (
                            <a
                                href={I18n::path($locale, '/docs/' . $pn['prev']->slug)}
                                className="flex-1 flex flex-col gap-1.5 px-4 py-4 bg-sheet hover:bg-draft/[0.05] no-underline group"
                            >
                                <span className="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{$en ? '◂ Previous' : '◂ 前へ'}</span>
                                <span className="font-medium text-ink group-hover:text-draft">{$pn['prev']->title}</span>
                            </a>
                        ) : (<span className="flex-1 bg-sheet"></span>)}
                        {null !== $pn['next'] ? (
                            <a
                                href={I18n::path($locale, '/docs/' . $pn['next']->slug)}
                                className="flex-1 flex flex-col gap-1.5 px-4 py-4 bg-sheet hover:bg-draft/[0.05] sm:text-right no-underline group"
                            >
                                <span className="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">{$en ? 'Next ▸' : '次へ ▸'}</span>
                                <span className="font-medium text-ink group-hover:text-draft">{$pn['next']->title}</span>
                            </a>
                        ) : (<span className="flex-1 bg-sheet"></span>)}
                    </div>
                ) : null}

                <div className="mt-10 pt-5 border-t border-rule">
                    <div className="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
                        {($en ? 'Last revised — ' : '最終更新 — ') . When::date($lastChanged)}
                    </div>
                    {[] !== $revisions ? (
                        <details className="mt-3">
                            <summary className="cursor-pointer font-mono text-[10px] uppercase tracking-[0.18em] text-muted hover:text-draft select-none">
                                {($en ? 'Revisions (' : '改訂履歴 (') . \count($revisions) . ')'}
                            </summary>
                            <ul className="list-none m-0 mt-3 p-0 border-l border-rule">
                                {array_map(fn ($r) => (
                                    <li className="flex flex-wrap items-baseline gap-x-3 gap-y-0.5 pl-4 py-1.5 text-sm min-w-0">
                                        <time className="font-mono text-[11px] tabular-nums text-muted">{When::date($r->recordedAt)}</time>
                                        <span className="text-ink break-words min-w-0">
                                            {'' !== $r->summary ? $r->summary : ($r->id === $oldestRevId ? ($en ? 'Created' : '新規作成') : ($en ? 'Updated' : '更新'))}
                                        </span>
                                    </li>
                                ), $revisions)}
                            </ul>
                        </details>
                    ) : null}
                </div>
            </article>
        </Shell>
    );
};
